# Copy to .env and replace the placeholders. Never commit .env.
APP_ENV=development
APP_BASE_URL=http://localhost:9000
SECRET_KEY=replace-with-a-random-secret
MONGO_URL=mongodb://localhost:27017
MONGO_DB=evolve
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-website-client-id
AUTH0_CLIENT_SECRET=your-website-client-secret
AUTH0_ROLES_CLAIM=https://evolve.example/roles
AUTH0_PRO_ROLE=pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
AI_REQUESTS_PER_HOUR=20
LANGUAGE_TRUSTED_PROXIES=

# MCP is served by the same Flask/Gunicorn application at APP_BASE_URL/mcp.
# The Auth0 API Identifier must be exactly APP_BASE_URL/mcp, without a trailing slash.
MCP_ENABLED=false
# Optional extra browser origins, comma-separated, without paths/trailing slashes.
# APP_BASE_URL and https://chatgpt.com are already allowed.
MCP_ALLOWED_ORIGINS=
