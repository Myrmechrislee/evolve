{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EVOLVE: Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "APP_ENV": "development",
        "APP_BASE_URL": "http://localhost:9000",
        "MONGO_URL": "mongodb://127.0.0.1:27017"
      },
      "args": [
        "--app", "app",
        "run",
        "--debug",
        "--no-debugger",
        "--no-reload",
        "--host", "127.0.0.1",
        "--port", "9000"
      ],
      "console": "integratedTerminal",
      "jinja": true
    }
  ]
}
